## Article 17. Deadline for filing a complaint

```catala
declaration scope Article17ComplaintDeadline:
  input decisionDate content integer
  input citizenInformedDate content integer
  input complaintFiledDate content integer
  input oneYearPassed content YesNo
  input hasRespectableReason content YesNo
  output withinOneMonthOfInforming content YesNo
  output withinOneYearOfDecision content YesNo
  output deadlineMissed content YesNo
  output deadlineMissedForRespectableReason content YesNo
  output deadlineCanBeRenewed content YesNo
  output complaintRejectedAsLate content YesNo
  output courtAppealAllowed content YesNo

scope Article17ComplaintDeadline:
  label within_month_exception
    exception default_not_within_month

  definition withinOneMonthOfInforming under condition
    not (citizenInformedDate = 0)
    consequence equals Yes

  label default_not_within_month definition withinOneMonthOfInforming equals No

  label within_year_exception
    exception default_not_within_year

  definition withinOneYearOfDecision under condition
    not (decisionDate = 0)
    consequence equals Yes

  label default_not_within_year definition withinOneYearOfDecision equals No

  label deadline_missed_exception
    exception default_deadline_ok

  definition deadlineMissed under condition
    oneYearPassed = Yes
    or withinOneMonthOfInforming = No
    consequence equals Yes

  label default_deadline_ok definition deadlineMissed equals No

  definition deadlineMissedForRespectableReason equals hasRespectableReason

  label renewal_exception
    exception default_no_renewal

  definition deadlineCanBeRenewed under condition
    deadlineMissed = Yes and deadlineMissedForRespectableReason = Yes
    consequence equals Yes

  label default_no_renewal definition deadlineCanBeRenewed equals No

  label rejected_late_exception
    exception default_not_rejected

  definition complaintRejectedAsLate under condition
    deadlineMissed = Yes and deadlineCanBeRenewed = No
    consequence equals Yes

  label default_not_rejected definition complaintRejectedAsLate equals No

  definition courtAppealAllowed equals Yes # Always allowed by Law
```
