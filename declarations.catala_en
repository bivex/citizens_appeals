```catala
declaration enumeration YesNo:
  -- No
  -- Yes

declaration enumeration AppealType:
  -- Proposal
  -- Application
  -- Complaint

declaration enumeration AppealForm:
  -- Written
  -- Oral
  -- Electronic

declaration enumeration AppealStatus:
  -- Submitted
  -- UnderReview
  -- Transferred
  -- RejectedAnonymous
  -- RejectedLate
  -- ReviewedByFirstManager
  -- Resolved

declaration enumeration ApplicantCategory:
  -- None
  -- Citizen
  -- MilitaryServiceMember
  -- PoliceOfficer
  -- SBUMember
  -- PrisonServiceMember
  -- Foreigner
  -- HeroOfUSSR
  -- HeroOfSocialistLabor
  -- WarDisabled
  -- DeclaredIncapacitated
  -- Minor
  -- Collective

declaration enumeration AddresseeType:
  -- StateAuthority
  -- LocalSelfGov
  -- AssociationOfCitizens
  -- Enterprise
  -- Institution
  -- Organization
  -- Media
  -- Official
  -- President
  -- Parliament
  -- Cabinet
  -- LocalCouncil

declaration enumeration LegalResponsibilityType:
  -- Civil
  -- Administrative
  -- Criminal

declaration structure AppealAuthor:
  data category content ApplicantCategory
  data signed content YesNo
  data submissionDate content integer
  data lastName content integer
  data firstName content integer
  data residence content integer
  data emailAddress content integer

declaration structure ComplaintSubject:
  data actionsDecisions content YesNo
  data rightsViolated content YesNo
  data freedomsViolated content YesNo
  data unlawfulObligations content YesNo
  data unlawfulResponsibility content YesNo

declaration structure EvidenceDocument:
  data hasPreviousDecisions content YesNo
  data documentDate content integer
```
